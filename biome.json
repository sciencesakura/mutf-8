{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": ["**", "!**/*.test-data.*"]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "linter": {
    "rules": { "preset": "recommended" }
  },
  "assist": {
    "actions": { "recommended": true }
  },
  "formatter": {
    "useEditorconfig": true,
    "lineWidth": 120
  }
}
